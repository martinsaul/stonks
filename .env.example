# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Long random secret mixed into one-time-passcode hashes (e.g. `openssl rand -hex 32`).
STONKS_OTP_PEPPER=change-me
# Optional: fix the world seed (only used when the world is first created).
STONKS_WORLD_SEED=
# Development only: returns OTP codes in API responses and allows localhost CORS.
STONKS_DEV_MODE=false
# Only needed if a browser app on another origin calls the API directly
# (the bundled web client is served on the same origin).
STONKS_CORS_ORIGINS=
STONKS_HTTP_PORT=8080
# Admin console: comma-separated admin emails, plus a long random key
# (e.g. `openssl rand -hex 24`) that admins enter in the console. Without the key
# the console is disabled. The key matters while every sign-in code is 111111
# (STONKS_FIXED_OTP): anyone can sign in as any address, so the email alone
# proves nothing.
STONKS_ADMIN_EMAILS=
STONKS_ADMIN_KEY=
