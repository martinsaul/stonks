# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Long random secret mixed into one-time-passcode hashes (e.g. `openssl rand -hex 32`).
STONKS_OTP_PEPPER=change-me
# Optional: fix the world seed (only used when the world is first created).
STONKS_WORLD_SEED=
# Development only: returns OTP codes in API responses and allows localhost CORS.
STONKS_DEV_MODE=false
# Set true only behind a reverse proxy you control (uses X-Forwarded-For for rate limits).
STONKS_TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API, e.g. https://stonks.example.com
STONKS_CORS_ORIGINS=
STONKS_HTTP_PORT=8080
